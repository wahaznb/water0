<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.water0.hydration">

    <!-- Notifications (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot completed for rescheduling -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Health Connect runtime reads. The API 34+ platform sheet
      auto-denies permissions that aren't declared here — this was
      the whole connect failure (provider available, grant impossible).
      Mirrors health_permissions.xml + readPermissions(). -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- Health Connect (optional, API 34+) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".Water0Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Water0"
        tools:targetApi="34">
        
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Water0"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Health Connect rationale screens. Must mirror the
             platform contract exactly: the controller drops permission
             requests when it can't resolve these (empty sheet, no UI).
             Category is android.intent.category.HEALTH_PERMISSIONS and
             the usage screen carries START_VIEW_PERMISSION_USAGE. -->
        <activity
            android:name=".presentation.health.HealthRationaleActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:theme="@style/Theme.Water0">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".presentation.notification.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Shade quick-log action: explicit intents only, never exported. -->
        <receiver
            android:name=".presentation.notification.WaterLogReceiver"
            android:exported="false" />

        <!-- Health Connect permission declaration -->
        <meta-data
            android:name="android.health.connect.PERMISSIONS"
            android:resource="@xml/health_permissions" />
    </application>
</manifest>